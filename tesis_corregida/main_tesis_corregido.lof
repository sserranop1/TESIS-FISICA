\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Imagen compuesta de Sextans A obtenida con Suprime-Cam en el telescopio Subaru. La composición combina observaciones en los filtros $V$, $R$ e $I$, asociados a los canales azul, verde y rojo, respectivamente. La imagen muestra poblaciones estelares jóvenes de color azul, poblaciones más evolucionadas de tonos amarillos y rojos, y regiones asociadas a gas ionizado por estrellas masivas jóvenes \citep {subaru2004sextansa}. }}{20}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Control visual del procedimiento semiautomático para el chip 5 de Sextans A en $V$. Los círculos verdes señalan las quince fuentes usadas para estimar el FWHM y los cuadrados cian las quince cajas de cielo; las líneas delimitan la malla de cinco columnas y tres filas.}}{28}{figure.caption.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Magnitud instrumental frente al error fotométrico en una imagen de M92 (izquierda) y en M41 (derecha).}}{31}{figure.caption.11}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Diagrama color--magnitud instrumental de M92 después de los filtros iniciales. El color horizontal es $B-V$ y la magnitud vertical corresponde a $V$.}}{32}{figure.caption.12}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Dispersión del cielo medida en las dieciséis regiones del chip 1. Las dos cajas por encima del límite superior de Tukey se excluyeron; la línea punteada inferior indica la mediana adoptada para $\sigma _{\mathrm {sky}}$.}}{34}{figure.caption.13}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Número de detecciones de \texttt {DAOFIND} en función del umbral probado para V en el chip 1. La línea vertical marca el umbral adoptado, $3.55$.}}{35}{figure.caption.14}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Ajuste cuadrático de $\ln N$ frente al umbral. La intersección de la pendiente del ajuste con $-1$ determina el valor operacional $3.55$.}}{35}{figure.caption.15}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Distribución de los errores fotométricos válidos. La visualización del histograma se limita a $MERR\leq 2$ mag para hacer visible la región de mayor concentración; el resumen estadístico se calculó con las $5\,047$ mediciones válidas.}}{37}{figure.caption.16}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Número de fuentes conservadas al variar el límite superior de \texttt {MERR}. La línea vertical señala el corte provisional de $0.20$ mag, que retiene $745$ fuentes.}}{37}{figure.caption.17}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Distancia al vecino detectado más cercano para las fuentes de la muestra de calidad. Las fuentes con distancia menor o igual a $13.53$ píxeles se excluyeron del análisis del anillo.}}{38}{figure.caption.18}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Distribución de $f_{\mathrm {out}}$ para las fuentes aisladas. Los valores por encima del límite global de $2.07\%$ se clasificaron como anillos fijos contaminados.}}{39}{figure.caption.19}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Número de fuentes asignadas a cada anillo después de la selección adaptativa. El grupo con el anillo original reúne las $323$ fuentes limpias; los otros cuatro grupos corresponden a fuentes cuyo anillo fue desplazado.}}{40}{figure.caption.20}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Fracción de píxeles altos antes y después de desplazar el anillo para las 43 fuentes recuperadas. Los puntos bajo la diagonal indican menor contaminación según $f_{\mathrm {out}}$; la línea horizontal marca el límite final de $2.07\%$.}}{41}{figure.caption.21}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Distribución de $\Delta MAG$ para las fuentes recuperadas. La mediana, $-0.004$ mag, es cercana a cero y la mediana de la diferencia absoluta es $0.019$ mag.}}{42}{figure.caption.22}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces Número de fuentes que permanece en las etapas principales del procesamiento de V en el chip 1. El total de anillos aceptados incluye fuentes con anillo fijo limpio y fuentes recuperadas al desplazar el anillo.}}{43}{figure.caption.23}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Conteos por etapa para los chips 2--8: corrida anterior en azul y corrida semiautomática con los múltiplos de apertura de la Tabla~\ref {tab:sextans-chips} en naranja. Los distintos conteos muestran el efecto conjunto de la selección y de la configuración de cada corrida; no deben interpretarse como un experimento de apertura controlado.}}{45}{figure.caption.26}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Comparación de magnitudes, errores y flujo para fuentes con anillo desplazado en los chips 2--8. Se presentan la corrida previa y la corrida semiautomática; cada punto resume la estadística del subconjunto correspondiente de un chip.}}{46}{figure.caption.27}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces Fracción de píxeles altos en los anillos de cielo antes de la selección adaptativa, después de desplazar los anillos y cambio entre ambas etapas para los chips 2--8.}}{47}{figure.caption.28}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Chip 5 en el filtro $B$. Se marcan las fuentes con fotometría válida, las que conservaron un anillo fijo limpio y la fuente recuperada con el anillo adaptativo.}}{50}{figure.caption.32}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces Chip 5 en el filtro $V$. Los símbolos distinguen las mediciones fotométricas válidas, el grupo aceptado con anillo fijo y las cuatro fuentes recuperadas con un anillo adaptativo.}}{50}{figure.caption.33}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces Chip 5 en el filtro $I$. Se muestran las mediciones fotométricas válidas, el grupo aceptado con anillo fijo y las trece fuentes recuperadas con un anillo adaptativo.}}{51}{figure.caption.34}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Ejemplo recuperado en $B$. El anillo fijo se muestra en naranja, el adaptativo en verde y la apertura en cian.}}{52}{figure.caption.35}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces Ejemplo recuperado en $V$. El anillo fijo se muestra en naranja, el adaptativo en verde y la apertura en cian.}}{52}{figure.caption.36}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Ejemplo recuperado en $I$. El anillo fijo se muestra en naranja, el adaptativo en verde y la apertura en cian.}}{53}{figure.caption.37}%
