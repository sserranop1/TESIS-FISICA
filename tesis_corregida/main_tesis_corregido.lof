\contentsline {figure}{\numberline {3.6}{\ignorespaces Análisis utilizado para estudiar la variación del número de detecciones en función del umbral de detección. $y = 598.16 + \frac {147655.86}{1 + e^{2.554(x-1.967)}}$ }}{39}{figure.caption.19}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Estrellas detectadas automáticamente en \texttt {m92011.fits} utilizando \texttt {daofind} con un umbral de detección de 3.5. }}{40}{figure.caption.20}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Estrellas detectadas automáticamente en M41 utilizando \texttt {daofind} y verificadas visualmente mediante \texttt {tvmark}. }}{41}{figure.caption.21}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Magnitud instrumental frente a error fotométrico para \texttt {m92010.fits}. }}{42}{figure.caption.22}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Magnitud instrumental frente a error fotométrico para M41. }}{42}{figure.caption.23}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Diagrama color--magnitud instrumental inicial de M92. El eje horizontal corresponde al color $B-V$ y el eje vertical a la magnitud instrumental $V$. }}{43}{figure.caption.24}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Fuentes rechazadas por presentar un vecino dentro del radio de $3\times FWHM$. }}{44}{figure.caption.25}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces Fuentes aceptadas después de aplicar el criterio de vecinos más cercanos. }}{45}{figure.caption.26}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Fracción de píxeles atípicos altos encontrados en los anillos de cielo. }}{46}{figure.caption.27}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces Estrellas rechazadas debido a indicios de contaminación dentro del anillo utilizado para determinar el fondo local. }}{47}{figure.caption.28}%
\contentsline {figure}{\numberline {3.16}{\ignorespaces Estrellas aceptadas después de aplicar el filtro de contaminación del anillo de cielo. }}{48}{figure.caption.29}%
\contentsline {figure}{\numberline {3.17}{\ignorespaces Diagrama color--magnitud de M92 después de aplicar los diferentes criterios de filtrado fotométrico. }}{49}{figure.caption.30}%
\contentsline {figure}{\numberline {3.18}{\ignorespaces Dispersión del cielo medida en las dieciséis regiones del chip 1. Las dos cajas por encima del límite superior de Tukey se excluyeron; la línea punteada inferior indica la mediana adoptada para $\sigma _{\mathrm {sky}}$.}}{51}{figure.caption.31}%
\contentsline {figure}{\numberline {3.19}{\ignorespaces Número de detecciones de \texttt {DAOFIND} en función del umbral probado para V en el chip 1. La línea vertical marca el umbral adoptado, $3.55$.}}{52}{figure.caption.32}%
\contentsline {figure}{\numberline {3.20}{\ignorespaces Ajuste cuadrático de $\ln N$ frente al umbral. La intersección de la pendiente del ajuste con $-1$ determina el valor operacional $3.55$.}}{52}{figure.caption.33}%
\contentsline {figure}{\numberline {3.21}{\ignorespaces Distribución de los errores fotométricos válidos. La visualización del histograma se limita a $MERR\leq 2$ mag para hacer visible la región de mayor concentración; el resumen estadístico se calculó con las $5\,047$ mediciones válidas.}}{54}{figure.caption.34}%
\contentsline {figure}{\numberline {3.22}{\ignorespaces Número de fuentes conservadas al variar el límite superior de \texttt {MERR}. La línea vertical señala el corte provisional de $0.20$ mag, que retiene $745$ fuentes.}}{54}{figure.caption.35}%
\contentsline {figure}{\numberline {3.23}{\ignorespaces Distancia al vecino detectado más cercano para las fuentes de la muestra de calidad. Las fuentes con distancia menor o igual a $13.53$ píxeles se excluyeron del análisis del anillo.}}{55}{figure.caption.36}%
\contentsline {figure}{\numberline {3.24}{\ignorespaces Distribución de $f_{\mathrm {out}}$ para las fuentes aisladas. Los valores por encima del límite global de $2.07\%$ se clasificaron como anillos fijos contaminados.}}{56}{figure.caption.37}%
\contentsline {figure}{\numberline {3.25}{\ignorespaces Número de fuentes asignadas a cada anillo después de la selección adaptativa. El grupo con el anillo original reúne las $323$ fuentes limpias; los otros cuatro grupos corresponden a fuentes cuyo anillo fue desplazado.}}{57}{figure.caption.38}%
\contentsline {figure}{\numberline {3.26}{\ignorespaces Fracción de píxeles altos antes y después de desplazar el anillo para las 43 fuentes recuperadas. Los puntos bajo la diagonal indican menor contaminación según $f_{\mathrm {out}}$; la línea horizontal marca el límite final de $2.07\%$.}}{58}{figure.caption.39}%
\contentsline {figure}{\numberline {3.27}{\ignorespaces Distribución de $\Delta MAG$ para las fuentes recuperadas. La mediana, $-0.004$ mag, es cercana a cero y la mediana de la diferencia absoluta es $0.019$ mag.}}{59}{figure.caption.40}%
\contentsline {figure}{\numberline {3.28}{\ignorespaces Número de fuentes que permanece en las etapas principales del procesamiento de V en el chip 1. El total de anillos aceptados incluye fuentes con anillo fijo limpio y fuentes recuperadas al desplazar el anillo.}}{60}{figure.caption.41}%
\contentsline {figure}{\numberline {3.29}{\ignorespaces Conteos por etapa para los chips 2--8: corrida anterior en azul y corrida semiautomática con los múltiplos de apertura de la Tabla~\ref {tab:sextans-chips} en naranja. Los distintos conteos muestran el efecto conjunto de la selección y de la configuración de cada corrida; no deben interpretarse como un experimento de apertura controlado.}}{62}{figure.caption.44}%
\contentsline {figure}{\numberline {3.30}{\ignorespaces Comparación de magnitudes, errores y flujo para fuentes con anillo desplazado en los chips 2--8. Se presentan la corrida previa y la corrida semiautomática; cada punto resume la estadística del subconjunto correspondiente de un chip.}}{63}{figure.caption.45}%
\contentsline {figure}{\numberline {3.31}{\ignorespaces Fracción de píxeles altos en los anillos de cielo antes de la selección adaptativa, después de desplazar los anillos y cambio entre ambas etapas para los chips 2--8.}}{64}{figure.caption.46}%
\contentsline {figure}{\numberline {3.32}{\ignorespaces Ubicación de fuentes recuperadas en las imágenes completas del chip 5. Los círculos ámbar indican fuentes cuyo anillo fijo fue clasificado como contaminado y para las que se aceptó un anillo alternativo; los recuadros cian marcan las regiones ampliadas en la Figura~\ref {fig:sextans-chip5-recovered-cutouts}.}}{67}{figure.caption.50}%
\contentsline {figure}{\numberline {3.33}{\ignorespaces Recortes del chip 5 alrededor de una fuente recuperada en cada filtro. Los círculos ámbar discontinuos muestran los límites del anillo fijo, los verdes los límites del anillo adaptativo y los cian la apertura. Se incluye el cambio individual de magnitud de cada ejemplo.}}{67}{figure.caption.51}%
